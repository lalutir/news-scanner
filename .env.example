# Scoped Mailgun API key used to send the digest
MAILGUN_API_KEY=

# mg.lalutir.com
MAILGUN_DOMAIN=

# The sending address, e.g. noreply@lalutir.com
DIGEST_FROM_EMAIL=

# Comma-separated recipient list
DIGEST_RECIPIENTS=

# Used for relevance filtering and the daily-briefing/summary generation (Haiku)
ANTHROPIC_API_KEY=
